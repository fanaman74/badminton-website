# Copy to .env.local and fill in your own values. Never commit real secrets.
#   cp .env.example .env.local

# ── Required ──────────────────────────────────────────────────────────────────
# Neon pooled connection string, used by the app at runtime.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────────────
# Neon direct (unpooled) connection, used by scripts/migrate-neon.ts and scripts/seed.ts.
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Resend API key (https://resend.com) used for login codes and RSVP confirmation emails.
# Without it no email is sent: in development the login code is printed to the terminal,
# and in production email-code sign-in fails with "Email service is not configured".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: sender address for those emails. Must be on a domain verified in Resend.
# Defaults to "VUB Smashers <notifications@msoit.eu>" — the verified domain in the
# club's Resend account. Set this to send from a different verified domain.
# RESEND_FROM_EMAIL=VUB Smashers <notifications@your-verified-domain.com>

# Public origin used to build OAuth/callback links.
# On Railway this is inferred from RAILWAY_PUBLIC_DOMAIN when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in — leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
